# Delta Finance — apps/api
#
# Copy to apps/api/.env and fill in. Values here are placeholders and examples,
# never real credentials: the real file is gitignored and stays that way.
#
# Only the four under "Required" have no working default. Everything else runs
# without being set — the feature it belongs to is simply off, which is the
# intended state for an installation that is not using it.

# ── Required ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/finanace
# At least 16 characters each. Different from one another.
JWT_ACCESS_SECRET=change-me-to-something-long-and-random
JWT_REFRESH_SECRET=change-me-to-something-else-long-and-random

# ── Where it runs ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# The address people actually use. Every link in every email is built from it,
# so a default left in place mails the whole company links to localhost.
WEB_ORIGIN=http://localhost:3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Mail ──────────────────────────────────────────────────────────────────────
#
# Two ways out, and the one in use depends only on what is set. Resend wins
# where its key is present; otherwise SMTP; with neither, sending is a logged
# no-op and nothing leaves.
#
# FROM_EMAIL must be an address the provider will send from — a domain verified
# with Resend, or the SMTP account itself (or a verified alias of it: Gmail
# rejects a From that is neither). Left as the .local placeholder with a
# transport configured, the API refuses to start rather than failing silently
# on every message — except with SMTP, where it falls back to SMTP_USER and
# warns.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" for implicit TLS on 465. Blank lets the port decide, which is right
# for 587 and its STARTTLS upgrade.
SMTP_SECURE=
FROM_EMAIL=billing@your-domain.com
FROM_NAME="Delta Finance"

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
#
# Invoice attachments, receipts and payment proofs. The sales CRM writes
# enrolment receipts into this same bucket, so both applications share these
# five values — one receipt is one object, not a copy on each side.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=delta-uploads
# The public base URL the bucket is served from.
R2_PUBLIC_URL=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
#
# Recurring invoices and expenses, payment reminders, the payroll-waiting
# check. On in exactly one process: two processes against one database send
# every reminder twice and issue every recurring invoice twice.
RUN_SCHEDULERS=true
# Reminders need this. Without Redis they are silently not sent at all.
REDIS_URL=redis://localhost:6379

# ── HRMS handover (outbound) ──────────────────────────────────────────────────
HRMS_API_URL=
HRMS_CLIENT_ID=
HRMS_INTEGRATION_SECRET=

# ── Giving the student their course (outbound, to the LMS) ────────────────────
#
# When an approver signs off an enrolment the sales CRM raised, this creates
# the student in the LMS, enrols and approves them on the mapped course, and
# the LMS emails them a login link.
#
# LMS_S2S_SECRET must be the same string as FINANCE_S2S_SECRET on the LMS side.
# LMS_API_URL is accepted with or without the /api/v1 suffix.
#
# Unset, approvals behave exactly as before and nobody is provisioned.
#
# Only enrolments that came from the CRM are ever sent — an invoice raised here
# is a billing document, not a sale of a course, and never reaches the LMS. The
# course is identified by the slug mapped onto the item (Inventory → item → LMS
# Course), never by the course name.
LMS_API_URL=
LMS_S2S_SECRET=

# ── Enrolments arriving from the CRM (inbound) ────────────────────────────────
#
# Must match FINANCE_CLIENT_ID / FINANCE_INTEGRATION_SECRET in the CRM.
INBOUND_CLIENT_ID=crm
INBOUND_INTEGRATION_SECRET=

# ── First run only (scripts/seed.ts) ──────────────────────────────────────────
SEED_ORG_NAME="Delta HQ"
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL=superadmin@your-domain.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
