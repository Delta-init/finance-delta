# Delta Finance — environment template. Copy to `.env` and fill in.
#
# Every value here is a placeholder. Real secrets belong in `.env`, which is
# gitignored; this file is committed, so anything written here is published to
# whoever can read the repository.
#
# See docs/ENVIRONMENT.md and docs/SECURITY.md.

# ── Core ──
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database (replica set required for transactions) ──
MONGODB_URI=mongodb://localhost:27017/delta?replicaSet=rs0

# ── Auth ──
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Jobs / realtime ──
REDIS_URL=redis://localhost:6379

# ── Email (Resend) ──
# Left empty, sending is a logged no-op. The SMTP_* keys this section used to
# list are read nowhere in the codebase — mail goes through Resend, so filling
# those in produced no email and no explanation.
RESEND_API_KEY=
FROM_EMAIL=noreply@delta.local
FROM_NAME=Delta Finance

# ── FX rates (optional) ──
FX_PROVIDER_API_KEY=

# ── HRMS integration (payroll) ──
# The HRMS API origin, and the shared-secret credentials we sign requests with.
# All three empty disables the payroll integration cleanly.
#
# HRMS_API_URL is the origin only — no /api/v1 — because the client appends the
# full path itself. The client id and secret must match INTEGRATION_CLIENT_ID /
# INTEGRATION_SECRET on the HRMS side, and the secret must be at least 32 chars
# (openssl rand -hex 32). Both servers' clocks must agree to within 5 minutes.
HRMS_API_URL=http://localhost:5055
HRMS_CLIENT_ID=delta-finance
HRMS_INTEGRATION_SECRET=

# ── Deferred provider seams ──
PAYMENT_GATEWAY_KEY=
OCR_PROVIDER_KEY=
EINVOICE_PROVIDER_KEY=

# ── Frontend (public) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── NextAuth / Auth.js (server-only) ──
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
API_INTERNAL_URL=http://localhost:4000/api/v1

# ── First admin, created by `bun run seed` ──
# Set real values in `.env` before seeding; the passwords below are blank on
# purpose so a deployment cannot inherit a well-known login from this template.
SEED_ORG_NAME=Delta HQ
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
